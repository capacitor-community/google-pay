{
  "name": "root",
  "private": true,
  "devDependencies": {
    "lerna": "^4.0.0"
  },
  "scripts": {
    "postinstall": "lerna bootstrap",
    "lerna:publish:dev": "lerna publish prerelease --conventional-commits --conventional-prerelease --no-changelog --preid dev-$(git rev-parse --short HEAD) --dist-tag dev --force-publish --no-git-tag-version --no-push --no-verify-access --yes",
    "lerna:publish:beta": "lerna publish from-git --conventional-commits --conventional-prerelease --preid beta --dist-tag next --force-publish --no-verify-access --yes",
    "lerna:publish:latest": "lerna publish from-git --conventional-commits --conventional-prerelease --dist-tag latest --force-publish --no-verify-access --yes",
    "lerna:version:beta": "lerna version prerelease --force-publish --preid beta",
    "lerna:version:latest": "lerna version --conventional-commits --force-publish",
    "release:beta": "npm run lerna:version:beta",
    "release:latest": "npm run lerna:version:latest",
    "clean-change-log": "node ./scripts/clean-changelog.js && lerna run clean-change-log",
    "update-changelog": "npm run clean-change-log && node ./scripts/update-docs-changelog.js",
    "release-ci": "lerna updated -l && lerna version --conventional-commits --conventional-graduate --yes && lerna publish from-git --no-verify-access --yes"
  },
  "volta": {
    "node": "14.19.1",
    "npm": "6.14.16"
  }
}
